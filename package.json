{
  "name": "matra",
  "private": true,
  "version": "0.4.6",
  "description": "Matra — an AI writing partner for English and Bangla, for macOS.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "e2e": "playwright test",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build --target universal-apple-darwin"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@google/genai": "^3.6.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.12.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  }
}
